NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/workspace
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=12
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=debug

# Gmail SMTP (App Password required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_FROM="8HOUR <your-email@gmail.com>"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Or use the built-in: node -e "const w=require('web-push');console.log(JSON.stringify(w.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@8hour-workspace.com

# Frontend
FRONTEND_URL=http://localhost:5173

# Student email domain (for auto-generating student emails on import)
STUDENT_EMAIL_DOMAIN=@vnrvjiet.in
