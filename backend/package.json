{
  "name": "@workspace/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch dist/backend/src/index.js",
    "dev:build": "tsc --watch",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "setup": "npm run build && node dist/backend/src/db/migrate.js && node dist/backend/src/db/seed.js",
    "migrate": "node dist/backend/src/db/migrate.js",
    "seed": "node dist/backend/src/db/seed.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "seed:dev": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.14.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "winston": "^3.14.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
