# API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=522460567146-ubk3ojomopil8f68hl73jt1pj0jbbm68.apps.googleusercontent.com
VITE_AUTH_SERVER_URL=http://localhost:3115

# Server Configuration
VITE_PORT=5173

# QR Code Configuration
VITE_QR_REFRESH_INTERVAL=15
# QR version: 1 (roll|time|hash) or 2 (roll|name|time|hash)
VITE_QR_VERSION=2

# Environment Mode
# Set to 'production' to hide developer tools and raw QR data
# Set to 'dev' for development mode with full debugging tools
VITE_APP_ENV=dev

# Development Features
# Set to 'true' to enable roll number override (for testing/development)
VITE_ENABLE_ROLL_OVERRIDE=true



# Meal windows (HH:mm)
VITE_BREAKFAST_START=07:30
VITE_BREAKFAST_END=09:30
VITE_LUNCH_START=12:00
VITE_LUNCH_END=14:00
VITE_SNACKS_START=16:00
VITE_SNACKS_END=18:00
VITE_DINNER_START=19:30
VITE_DINNER_END=21:30

# Grace in minutes (applied +/- to start/end)
VITE_MEAL_GRACE_MINUTES=30